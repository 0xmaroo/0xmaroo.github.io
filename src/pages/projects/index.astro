---
import Base from '../../layouts/Base.astro';
import Seo from '../../components/Seo.astro';
import ProjectCard from '../../components/cards/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { projectSurface } from '../../lib/content';
import { useTranslations } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
const entries = await getCollection('projects');
const surfaced = projectSurface(entries, lang);
---

<Base lang={lang} title={`${t('projects.title')} — 0xMARO`} description={t('projects.desc')}>
  <Seo
    slot="head"
    lang={lang}
    path="/projects"
    title={`${t('projects.title')} — 0xMARO`}
    description={t('projects.desc')}
  />
  <div class="wrap archive">
    <header class="archive__head">
      <span class="archive__eyebrow ltr">{t('projects.eyebrow')}</span>
      <h1 class="archive__title">{t('projects.title')}</h1>
      <p class="archive__desc">{t('projects.desc')}</p>
      <p class="archive__count ltr">
        {t('projects.count').replace('{0}', String(surfaced.length))}
      </p>
    </header>

    {
      surfaced.length > 0 ? (
        <div class="archive__grid">
          {surfaced.map((e, i) => (
            <ProjectCard entry={e} index={i} />
          ))}
        </div>
      ) : (
        <p class="archive__empty">{t('projects.empty')}</p>
      )
    }
  </div>
</Base>

<style>
  .archive {
    padding-block: var(--space-7) var(--space-8);
  }

  .archive__head {
    border-block-end: var(--hairline) solid var(--line);
    padding-block-end: var(--space-6);
  }

  .archive__eyebrow {
    font-family: var(--f-code);
    font-size: var(--text-sm);
    color: var(--blue-500);
  }

  .archive__title {
    margin-block-start: var(--space-3);
  }

  .archive__desc {
    margin-block-start: var(--space-4);
    max-width: var(--measure-lead);
    font-size: var(--step-1);
    color: var(--text-lo);
    line-height: var(--lh-lead);
  }

  .archive__count {
    margin-block-start: var(--space-5);
    font-family: var(--f-code);
    font-size: var(--text-xs);
    color: var(--text-dim);
  }

  .archive__grid {
    margin-block-start: var(--space-6);
    display: grid;
    gap: var(--hairline);
    background: var(--line);
    border: var(--hairline) solid var(--line);
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
  }

  .archive__empty {
    margin-block-start: var(--space-7);
    color: var(--text-lo);
    font-size: var(--step-1);
  }
</style>
