---
import Base from '../../../layouts/Base.astro';
import Seo from '../../../components/Seo.astro';
import WriteupCard from '../../../components/cards/WriteupCard.astro';
import { getCollection } from 'astro:content';
import { caseNumbers, forSurface, slugOf } from '../../../lib/content';
import { useTranslations } from '../../../i18n/utils';

const lang = 'ar';
const t = useTranslations(lang);
const entries = await getCollection('writeups');
const surfaced = forSurface(entries, 'archive', lang);
const numbers = caseNumbers(entries);
---

<Base lang={lang} title={`${t('writeups.title')} — 0xMARO`} description={t('writeups.desc')}>
  <Seo slot="head" lang={lang} path="/writeups" />
  <div class="wrap archive">
    <header class="archive__head">
      <span class="archive__eyebrow ltr">{t('writeups.eyebrow')}</span>
      <h1 class="archive__title">{t('writeups.title')}</h1>
      <p class="archive__desc">{t('writeups.desc')}</p>
      <p class="archive__count ltr">{t('writeups.count').replace('{0}', String(surfaced.length))}</p>
    </header>

    {
      surfaced.length > 0 ? (
        <div class="archive__grid">
          {surfaced.map((e) => (
            <WriteupCard entry={e} caseNo={numbers.get(slugOf(e)) ?? 0} />
          ))}
        </div>
      ) : (
        <p class="archive__empty">{t('writeups.empty')}</p>
      )
    }
  </div>
</Base>

<style>
  .archive {
    padding-block: var(--space-7) var(--space-8);
  }

  .archive__head {
    border-block-end: var(--hairline) solid var(--line);
    padding-block-end: var(--space-6);
  }

  .archive__eyebrow {
    font-family: var(--f-code);
    font-size: var(--text-sm);
    color: var(--blue-500);
  }

  .archive__title {
    margin-block-start: var(--space-3);
  }

  .archive__desc {
    margin-block-start: var(--space-4);
    max-width: var(--measure-lead);
    font-size: var(--step-1);
    color: var(--text-lo);
    line-height: var(--lh-lead);
  }

  .archive__count {
    margin-block-start: var(--space-5);
    font-family: var(--f-code);
    font-size: var(--text-xs);
    color: var(--text-dim);
  }

  .archive__grid {
    margin-block-start: var(--space-6);
    display: grid;
    gap: var(--hairline);
    background: var(--line);
    border: var(--hairline) solid var(--line);
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
  }

  .archive__empty {
    margin-block-start: var(--space-7);
    color: var(--text-lo);
    font-size: var(--step-1);
  }
</style>
