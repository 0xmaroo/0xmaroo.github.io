---
import Base from '../../../layouts/Base.astro';
import Seo from '../../../components/Seo.astro';
import ArchiveFilters from '../../../components/archive/ArchiveFilters.astro';
import ArchiveList from '../../../components/archive/ArchiveList.astro';
import { getCollection } from 'astro:content';
import { forSurface, forSurfaceWithFallback } from '../../../lib/content';
import { useTranslations } from '../../../i18n/utils';

const lang = 'ar';
const t = useTranslations(lang);
const entries = await getCollection('writeups');
// Facet routes exist per locale, so filters read own-language entries only;
// the list itself adds the other language's posts with a badge (plan/01 §1.4).
const surfaced = forSurface(entries, 'archive', lang);
const listed = forSurfaceWithFallback(entries, 'archive', lang);
---

<Base lang={lang} title={`${t('writeups.title')} — 0xMARO`} description={t('writeups.desc')}>
  <Seo
    slot="head"
    lang={lang}
    path="/writeups"
    title={`${t('writeups.title')} — 0xMARO`}
    description={t('writeups.desc')}
  />
  <div class="wrap archive">
    <header class="archive__head">
      <span class="archive__eyebrow ltr">{t('writeups.eyebrow')}</span>
      <h1 class="archive__title">{t('writeups.title')}</h1>
      <p class="archive__desc">{t('writeups.desc')}</p>
      <p class="archive__count ltr">
        {t('writeups.count').replace('{0}', String(listed.length))}
      </p>
    </header>

    <ArchiveFilters lang={lang} entries={surfaced} />
    <ArchiveList lang={lang} entries={listed} all={entries} />
  </div>
</Base>

<style>
  .archive {
    padding-block: var(--space-7) var(--space-8);
  }

  .archive__head {
    border-block-end: var(--hairline) solid var(--line);
    padding-block-end: var(--space-6);
  }

  .archive__eyebrow {
    font-family: var(--f-code);
    font-size: var(--text-sm);
    color: var(--blue-500);
  }

  .archive__title {
    margin-block-start: var(--space-3);
  }

  .archive__desc {
    margin-block-start: var(--space-4);
    max-width: var(--measure-lead);
    font-size: var(--step-1);
    color: var(--text-lo);
    line-height: var(--lh-lead);
  }

  .archive__count {
    margin-block-start: var(--space-5);
    font-family: var(--f-code);
    font-size: var(--text-xs);
    color: var(--text-dim);
  }
</style>
