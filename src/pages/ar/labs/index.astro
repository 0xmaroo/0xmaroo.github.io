---
import Base from '../../../layouts/Base.astro';
import Seo from '../../../components/Seo.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { buildsInProd, slugOf, type Writeup } from '../../../lib/content';
import { surfaceLabs } from '../../../lib/proof';
import { useTranslations } from '../../../i18n/utils';

const lang = 'ar';
const t = useTranslations(lang);
const labs = await getCollection('labs');
const writeups = await getCollection('writeups');

const { shown, suppressed } = surfaceLabs(labs);
for (const s of suppressed) {
  console.warn(`[proof] lab "${s.id}" held back — no real proof URL.`);
}

const resolveWriteup = (slug: string): Writeup | undefined => {
  const local = writeups.find((w) => w.data.lang === lang && slugOf(w) === slug);
  const fallback = writeups.find((w) => w.data.lang === 'en' && slugOf(w) === slug);
  const found = local ?? fallback;
  return found && buildsInProd(found) ? found : undefined;
};

const platforms = [...new Set(labs.map((l) => l.data.platform))].sort();
const filter = new URL(Astro.url).searchParams.get('platform');
const rows = filter ? shown.filter((l) => l.data.platform === filter) : shown;

const yearOf = (d?: Date): string =>
  d ? new Intl.DateTimeFormat('ar', { year: 'numeric', numberingSystem: 'latn' }).format(d) : '—';
---

<Base lang={lang} title={`${t('labs.title')} — 0xMARO`} description={t('labs.desc')}>
  <Seo
    slot="head"
    lang={lang}
    path="/labs"
    title={`${t('labs.title')} — 0xMARO`}
    description={t('labs.desc')}
  />
  <div class="wrap archive">
    <header class="archive__head">
      <span class="archive__eyebrow ltr">{t('labs.eyebrow')}</span>
      <h1 class="archive__title">{t('labs.title')}</h1>
      <p class="archive__desc">{t('labs.desc')}</p>
      <p class="archive__count ltr">{t('labs.count').replace('{0}', String(shown.length))}</p>
    </header>

    <nav class="labs__filter" aria-label={t('labs.platform')}>
      <a
        class:list={['labs__chip ltr', !filter && 'is-on']}
        href={getRelativeLocaleUrl(lang, '/labs')}
      >
        {t('labs.all')}
      </a>
      {
        platforms.map((p) => (
          <a
            class:list={['labs__chip ltr', filter === p && 'is-on']}
            href={`${getRelativeLocaleUrl(lang, '/labs')}?platform=${encodeURIComponent(p)}`}
          >
            {p}
          </a>
        ))
      }
    </nav>

    {
      rows.length > 0 ? (
        <table class="labs__table">
          <thead>
            <tr>
              <th scope="col">{t('labs.platform')}</th>
              <th scope="col">{t('labs.year')}</th>
              <th scope="col">{t('labs.title')}</th>
              <th scope="col">{t('labs.writeup')}</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((l) => {
              const w = l.data.writeup ? resolveWriteup(l.data.writeup) : undefined;
              return (
                <tr>
                  <td class="ltr">{l.data.platform}</td>
                  <td class="ltr">{yearOf(l.data.date)}</td>
                  <td>
                    <a class="labs__proof" href={l.data.proof} rel="nofollow noreferrer">
                      {l.data.name}
                      {l.data.result && <span class="labs__result ltr">{l.data.result}</span>}
                    </a>
                  </td>
                  <td>
                    {w ? (
                      <a
                        class="labs__link"
                        href={getRelativeLocaleUrl(lang, `/writeups/${slugOf(w)}`)}
                      >
                        {t('labs.writeup')}
                      </a>
                    ) : (
                      <span class="labs__none" aria-hidden="true">
                        —
                      </span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      ) : (
        <p class="archive__empty">{filter ? t('labs.noMatch') : t('labs.empty')}</p>
      )
    }
  </div>
</Base>

<style>
  .archive {
    padding-block: var(--space-7) var(--space-8);
  }

  .archive__head {
    border-block-end: var(--hairline) solid var(--line);
    padding-block-end: var(--space-6);
  }

  .archive__eyebrow {
    font-family: var(--f-code);
    font-size: var(--text-sm);
    color: var(--blue-500);
  }

  .archive__title {
    margin-block-start: var(--space-3);
  }

  .archive__desc {
    margin-block-start: var(--space-4);
    max-width: var(--measure-lead);
    font-size: var(--step-1);
    color: var(--text-lo);
    line-height: var(--lh-lead);
  }

  .archive__count {
    margin-block-start: var(--space-5);
    font-family: var(--f-code);
    font-size: var(--text-xs);
    color: var(--text-dim);
  }

  .archive__empty {
    margin-block-start: var(--space-7);
    color: var(--text-lo);
    font-size: var(--step-1);
  }

  .labs__filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-6);
  }

  .labs__chip {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    padding-inline: var(--space-3);
    font-family: var(--f-cond);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--text-lo);
    text-decoration: none;
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
    transition:
      color var(--t-fast) ease,
      border-color var(--t-fast) ease;
  }

  .labs__chip:hover {
    color: var(--text-hi);
    border-color: var(--sulfur-400);
  }

  .labs__chip.is-on {
    color: var(--ink-900);
    background: var(--sulfur-400);
    border-color: var(--sulfur-400);
  }

  .labs__table {
    width: 100%;
    margin-block-start: var(--space-6);
    border-collapse: collapse;
    border: var(--hairline) solid var(--line);
    font-size: var(--step--1);
  }

  .labs__table th {
    text-align: start;
    font-family: var(--f-cond);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--blue-400);
    font-weight: 400;
    padding: var(--space-3) var(--space-4);
    border-block-end: var(--hairline) solid var(--line);
    background: var(--ink-800);
  }

  html[lang='ar'] .labs__table th {
    font-family: var(--f-body-ar);
    text-transform: none;
    letter-spacing: 0;
  }

  .labs__table td {
    padding: var(--space-3) var(--space-4);
    border-block-end: var(--hairline) solid var(--line);
    color: var(--text);
    vertical-align: top;
  }

  .labs__table tbody tr:last-child td {
    border-block-end: none;
  }

  .labs__table tbody tr:hover td {
    background: var(--ink-800);
  }

  .labs__proof {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    color: var(--text-hi);
    text-decoration: none;
    border-block-end: var(--hairline) solid transparent;
    min-height: var(--touch-min);
    justify-content: center;
  }

  .labs__proof:hover {
    color: var(--sulfur-300);
    border-block-end-color: var(--sulfur-400);
  }

  .labs__result {
    font-family: var(--f-code);
    font-size: var(--text-xs);
    color: var(--blue-400);
  }

  .labs__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    font-family: var(--f-cond);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--text-lo);
    text-decoration: none;
    border-block-end: var(--hairline) solid transparent;
  }

  html[lang='ar'] .labs__link {
    font-family: var(--f-body-ar);
    text-transform: none;
    letter-spacing: 0;
  }

  .labs__link:hover {
    color: var(--sulfur-300);
    border-block-end-color: var(--sulfur-400);
  }

  .labs__none {
    color: var(--text-dim);
  }
</style>
