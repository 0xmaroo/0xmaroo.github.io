---
import Base from '../../../layouts/Base.astro';
import Seo from '../../../components/Seo.astro';
import LabsPlatforms from '../../../components/labs/LabsPlatforms.astro';
import LabsTable from '../../../components/labs/LabsTable.astro';
import { getCollection } from 'astro:content';
import { labPlatforms, surfaceLabs } from '../../../lib/proof';
import { useTranslations } from '../../../i18n/utils';

const lang = 'ar';
const t = useTranslations(lang);
const labs = await getCollection('labs');
const writeups = await getCollection('writeups');

const { shown, suppressed } = surfaceLabs(labs);
for (const s of suppressed) {
  console.warn(`[proof] lab "${s.id}" held back — no real proof URL.`);
}

// Chips derive from surfaced labs only, and a platform below the facet
// threshold renders as text — the pre-rendered routes replace the old dead
// `?platform=` query-param filter, which never worked on a static build.
const platforms = labPlatforms(shown);
---

<Base lang={lang} title={`${t('labs.title')} — 0xMARO`} description={t('labs.desc')}>
  <Seo
    slot="head"
    lang={lang}
    path="/labs"
    title={`${t('labs.title')} — 0xMARO`}
    description={t('labs.desc')}
  />
  <div class="wrap archive">
    <header class="archive__head">
      <span class="archive__eyebrow ltr">{t('labs.eyebrow')}</span>
      <h1 class="archive__title">{t('labs.title')}</h1>
      <p class="archive__desc">{t('labs.desc')}</p>
      <p class="archive__count ltr">{t('labs.count').replace('{0}', String(shown.length))}</p>
    </header>

    <LabsPlatforms lang={lang} platforms={platforms} />
    <LabsTable lang={lang} rows={shown} writeups={writeups} />
  </div>
</Base>

<style>
  .archive {
    padding-block: var(--space-7) var(--space-8);
  }

  .archive__head {
    border-block-end: var(--hairline) solid var(--line);
    padding-block-end: var(--space-6);
  }

  .archive__eyebrow {
    font-family: var(--f-code);
    font-size: var(--text-sm);
    color: var(--blue-500);
  }

  .archive__title {
    margin-block-start: var(--space-3);
  }

  .archive__desc {
    margin-block-start: var(--space-4);
    max-width: var(--measure-lead);
    font-size: var(--step-1);
    color: var(--text-lo);
    line-height: var(--lh-lead);
  }

  .archive__count {
    margin-block-start: var(--space-5);
    font-family: var(--f-code);
    font-size: var(--text-xs);
    color: var(--text-dim);
  }
</style>
