---
import Base from '../layouts/Base.astro';
import Seo from '../components/Seo.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Rail from '../components/Rail.astro';
import DiffHero from '../components/hero/DiffHero.astro';
import StatStrip from '../components/proof/StatStrip.astro';
import WriteupCard from '../components/cards/WriteupCard.astro';
import ArsenalTable from '../components/proof/ArsenalTable.astro';
import JourneyTimeline from '../components/proof/JourneyTimeline.astro';
import { getCollection } from 'astro:content';
import { caseNumbers, documentedTopics, featuredOnHome, slugOf } from '../lib/content';
import { useTranslations } from '../i18n/utils';
import { siteDescription } from '../config/site';
import { personSchema, websiteSchema } from '../lib/schema';
import { journeyTimeline } from '../lib/proof';

const lang = 'en';
const t = useTranslations(lang);
const entries = await getCollection('writeups');
const featured = featuredOnHome(entries, lang);
const numbers = caseNumbers(entries);
// plan/07 §7.2 knowsAbout — derived from the site's own content, not asserted.
const arsenal = await getCollection('arsenal');
const topics = documentedTopics(
  entries,
  arsenal.map((a) => a.data.domain[lang]),
  lang
);
// §03 only renders once a station has cleared the proof and copy gates.
const stations = await journeyTimeline();
---

<Base lang={lang} title="0xMARO — Blueprint & Breach" description={siteDescription[lang]}>
  <Seo
    slot="head"
    lang={lang}
    path="/"
    title="0xMARO — Blueprint & Breach"
    description={siteDescription[lang]}
  />
  <!-- WebSite lives on the home page of each locale only; Person on home + About. -->
  <JsonLd slot="head" data={websiteSchema(lang, Astro.site!)} />
  <JsonLd slot="head" data={personSchema(topics)} />
  <Rail />
  <!-- Indexed so Pagefind never falls back to crawling every page (404,
       search, noindex placeholders) while no writeup carries data-pagefind-body. -->
  <div class="wrap hero" data-pagefind-body>
    <p class="hero__file ltr">{t('hero.file')}</p>
    <DiffHero lang={lang} />
    <p class="hero__sub">{t('hero.sub')}</p>
    {
      (featured.length > 0 || stations.length > 0) && (
        <div class="hero__cta">
          {featured.length > 0 && (
            <a class="btn btn--primary" href="#cases">
              {t('cta.casefiles')}
            </a>
          )}
          {stations.length > 0 && (
            <a class="btn" href="#journey">
              {t('cta.journey')}
            </a>
          )}
        </div>
      )
    }
    <StatStrip lang={lang} />
  </div>

  {
    featured.length > 0 && (
      <section id="cases" aria-labelledby="cases-title">
        <div class="wrap">
          <div class="sec__head reveal">
            <span class="sec__num ltr">{t('sec.cases.num')}</span>
            <h2 id="cases-title" class="sec__title">
              {t('sec.cases.title')}
            </h2>
            <p class="sec__note">{t('sec.cases.note')}</p>
          </div>

          <div class="cases reveal">
            {featured.map((e) => (
              <WriteupCard entry={e} caseNo={numbers.get(slugOf(e)) ?? 0} viewerLang={lang} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section id="arsenal" aria-labelledby="arsenal-title">
    <div class="wrap">
      <div class="sec__head reveal">
        <span class="sec__num ltr">{t('sec.arsenal.num')}</span>
        <h2 id="arsenal-title" class="sec__title">
          {t('arsenal.title')}
        </h2>
        <p class="sec__note">{t('sec.arsenal.note')}</p>
      </div>
      <div class="reveal">
        <ArsenalTable lang={lang} />
      </div>
    </div>
  </section>

  {
    stations.length > 0 && (
      <section id="journey" aria-labelledby="journey-title">
        <div class="wrap">
          <div class="sec__head reveal">
            <span class="sec__num ltr">{t('sec.journey.num')}</span>
            <h2 id="journey-title" class="sec__title">
              {t('journey.title')}
            </h2>
            <p class="sec__note">{t('sec.journey.note')}</p>
          </div>
          <div class="reveal">
            <JourneyTimeline lang={lang} level={3} stations={stations} />
          </div>
        </div>
      </section>
    )
  }
</Base>

<script>
  const revealEls = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px' }
    );
    for (const el of revealEls) io.observe(el);
  } else {
    for (const el of revealEls) el.classList.add('is-in');
  }
</script>

<style>
  .hero {
    padding-block: var(--pad-hero-block);
  }

  .hero__file {
    font-family: var(--f-code);
    font-size: var(--step--1);
    color: var(--text-dim);
    margin-block-end: var(--space-5);
  }

  .hero__file::before {
    content: '┌ ';
    color: var(--blue-500);
  }

  .hero__sub {
    margin-block-start: var(--space-6);
    max-width: var(--measure-lead);
    font-size: var(--step-1);
    line-height: var(--lh-lead);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }

  section {
    padding-block: var(--pad-section-block);
    border-block-start: var(--hairline) solid var(--line);
  }

  .sec__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-block-end: var(--space-6);
  }

  .sec__num {
    font-family: var(--f-code);
    font-size: var(--text-sm);
    color: var(--blue-500);
  }

  .sec__note {
    margin-inline-start: auto;
    max-width: var(--measure-lead);
    font-size: var(--step--1);
    color: var(--text-lo);
  }

  .cases {
    display: grid;
    gap: var(--hairline);
    background: var(--line);
    border: var(--hairline) solid var(--line);
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
  }
</style>
