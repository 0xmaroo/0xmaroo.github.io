---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import '../styles/typography.css';
import '../styles/print.css';
import Header from '../components/nav/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/nav/CommandPalette.astro';
import { useTranslations } from '../i18n/utils';
import { csp, referrerPolicy } from '../config/security';
import type { Language } from '../i18n/ui';

interface Props {
  lang: Language;
  title: string;
  description?: string;
  /**
   * Locale-free path the language switch uses when this page has no version
   * in the other language (e.g. '/writeups' for an English-only writeup).
   */
  langFallback?: string;
}

const { lang, title, description, langFallback } = Astro.props;
const t = useTranslations(lang);
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const bodyFont =
  lang === 'ar' ? '/fonts/IBMPlexSansArabic-400-arab.woff2' : '/fonts/IBMPlexSans-400-latin.woff2';
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Security meta — plan/08-quality-bar.md §8.1. Must precede every
         link/script/title: a meta CSP only governs what follows it. -->
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content={referrerPolicy} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <script src="/js/root.js" is:inline></script>
    <slot name="head" />
    <!-- TODO(infra): Cloudflare Web Analytics beacon (plan/05 Phase 5) — enable
         ONLY when the owner supplies the token; nothing is integrated yet and
         the live CSP above is untouched. This is the ONLY approved CSP widening
         ("one domain only"): static.cloudflareinsights.com joins script-src and
         cloudflareinsights.com joins connect-src; every other directive stays
         'self'. Switching it on is a copy-paste of the two lines below:
         1) add the two domains to script-src / connect-src in src/config/security.ts,
         2) uncomment the beacon script.

    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "TOKEN_HERE"}'></script>

    CSP (current policy + the two analytics hosts, nothing else changed):
    default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
    -->
  </head>
  <body>
    <a class="skip" href="#main">{t('skip')}</a>
    <Header lang={lang} langFallback={langFallback} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <CommandPalette lang={lang} langFallback={langFallback} />
  </body>
</html>
