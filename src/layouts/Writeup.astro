---
import Base from './Base.astro';
import Seo from '../components/Seo.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Stamp from '../components/writeup/Stamp.astro';
import Callout from '../components/writeup/Callout.astro';
import Payload from '../components/writeup/Payload.astro';
import FixDiff from '../components/writeup/FixDiff.astro';
import DeadEnd from '../components/writeup/DeadEnd.astro';
import Terminal from '../components/writeup/Terminal.astro';
import WriteupCard from '../components/cards/WriteupCard.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCollection, render } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { useTranslations } from '../i18n/utils';
import {
  caseNumbers,
  facetIndex,
  facetPath,
  facetSlug,
  forSurface,
  relatedByCwe,
  seriesOrdered,
  seriesParts,
  slugOf,
  type FacetKind,
  type Writeup,
} from '../lib/content';
import { ogImagePath } from '../lib/og';
import { readingTimeOf } from '../lib/reading-time';
import { breadcrumbSchema } from '../lib/schema';
import type { Language, UIKey } from '../i18n/ui';
import '../styles/prose.css';

interface Props {
  entry: Writeup;
  /** Counterpart entry in the other language, when one exists. */
  translation?: Writeup;
}

const { entry, translation } = Astro.props;
const data = entry.data;
const lang: Language = data.lang;
const t = useTranslations(lang);
const other: Language = lang === 'en' ? 'ar' : 'en';
const slug = slugOf(entry);
const path = `/writeups/${slug}`;
const { Content, headings } = await render(entry);

const minutes = data.readingTime ?? readingTimeOf(entry.body ?? '', lang);
const dateFmt = new Intl.DateTimeFormat(lang === 'ar' ? 'ar' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  numberingSystem: 'latn',
});
const publishedLabel = t('writeup.published').replace('{0}', dateFmt.format(data.publishedAt));
const updatedLabel =
  data.updatedAt && t('writeup.updated').replace('{0}', dateFmt.format(data.updatedAt));

const isUnlisted = data.visibility.unlisted;
const hideFromSearch = data.visibility.hideFrom.includes('search');
const noindex = data.visibility.noindex || isUnlisted;
const pagefindIgnore = isUnlisted || hideFromSearch;
const alternates = translation ? { [other]: path } : {};

// `getRelativeLocaleUrl()` appends a trailing slash even to file routes
// ('...slug.png/'), which 404s on GitHub Pages — strip it for the OG route.
const ogUrl = getRelativeLocaleUrl(lang, ogImagePath('writeups', slug)).replace(/\/+$/, '');

const toc: MarkdownHeading[] = headings.filter((h) => h.depth === 2);

// Archive context for the series strip, the related section and the facet
// links on metadata — everything derives from `forSurface('archive')` so a
// draft or unlisted entry can never leak in through a sidebar.
const allWriteups = await getCollection('writeups');
const archive = forSurface(allWriteups, 'archive', lang);
const facets = facetIndex(archive);
const parts = seriesParts(archive);
const numbers = caseNumbers(allWriteups);
const related = relatedByCwe(allWriteups, entry, lang);

// Metadata link vs text (plan/04 F-03): a value with its own route links to
// it; a below-threshold value is plain text, never a dead href.
const facetHref = (kind: FacetKind, value: string): string | undefined =>
  facets[kind].has(value)
    ? getRelativeLocaleUrl(lang, facetPath(kind, facetSlug(value)))
    : undefined;

const seriesMembers = data.series
  ? seriesOrdered(archive.filter((e) => e.data.series === data.series))
  : undefined;
const seriesHref = data.series ? facetHref('series', data.series) : undefined;
const severityHref = data.severity ? facetHref('severity', data.severity) : undefined;

const severityVariant = {
  critical: 'crit',
  high: 'high',
  medium: 'med',
  low: 'low',
  info: 'info',
} as const;
const statusVariant = {
  patched: 'ok',
  'lab-only': 'blue',
  disclosed: 'high',
  wip: 'med',
} as const;

const mdxComponents = { Callout, Payload, FixDiff, DeadEnd, Terminal };

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: data.title,
  description: data.summary,
  inLanguage: lang,
  datePublished: data.publishedAt.toISOString(),
  dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
  author: { '@type': 'Person', name: '0xMARO' },
  about: data.cwe.map((c) => ({ '@type': 'Thing', name: c })),
  keywords: data.tags.join(', '),
  mainEntityOfPage: new URL(getRelativeLocaleUrl(lang, path), Astro.site!).href,
};

const breadcrumb = breadcrumbSchema(lang, Astro.site!, [
  { name: t('breadcrumb.home'), path: '/' },
  { name: t('writeups.title'), path: '/writeups' },
  { name: data.title, path },
]);
---

<Base lang={lang} title={`${data.title} — 0xMARO`} description={data.summary}>
  <Seo
    slot="head"
    lang={lang}
    path={path}
    alternates={alternates}
    robots={noindex ? 'noindex' : 'index'}
    title={`${data.title} — 0xMARO`}
    description={data.summary}
    image={ogUrl}
    imageAlt={data.title}
  />
  <JsonLd slot="head" data={jsonLd} />
  <JsonLd slot="head" data={breadcrumb} />

  <article class="writeup">
    <header class="wrap writeup__head">
      <p class="writeup__eyebrow ltr">
        <span data-pagefind-filter="category">{data.category.toUpperCase()}</span> · {slug}
      </p>
      <h1 class="writeup__title" data-pagefind-meta="title">{data.title}</h1>
      <p class="writeup__summary">{data.summary}</p>

      <div class="writeup__meta">
        <div class="writeup__stamps">
          {
            data.severity &&
              (severityHref ? (
                <a class="writeup__sevlink" href={severityHref}>
                  <Stamp
                    variant={severityVariant[data.severity]}
                    label={t(`severity.${data.severity}` as UIKey)}
                  />
                </a>
              ) : (
                <Stamp
                  variant={severityVariant[data.severity]}
                  label={t(`severity.${data.severity}` as UIKey)}
                />
              ))
          }
          <Stamp variant={statusVariant[data.status]} label={t(`status.${data.status}` as UIKey)} />
        </div>

        <dl class="writeup__facts">
          <div class="fact">
            <dt>{t('filter.category')}</dt>
            <dd class="ltr">
              {
                facetHref('category', data.category) ? (
                  <a class="fact__link" href={facetHref('category', data.category)}>
                    {data.category}
                  </a>
                ) : (
                  data.category
                )
              }
            </dd>
          </div>
          <div class="fact">
            <dt>{t('writeup.target')}</dt>
            <dd class="ltr">{data.target}</dd>
          </div>
          <div class="fact">
            <dt>{t('writeup.targetType')}</dt>
            <dd class="ltr">
              {
                facetHref('type', data.targetType) ? (
                  <a class="fact__link" href={facetHref('type', data.targetType)}>
                    {data.targetType}
                  </a>
                ) : (
                  data.targetType
                )
              }
            </dd>
          </div>
          {
            data.cwe.length > 0 && (
              <div class="fact">
                <dt>CWE</dt>
                <dd class="ltr">
                  {data.cwe.map((c, i) => (
                    <>
                      {i > 0 && ', '}
                      {facetHref('cwe', c) ? (
                        <a class="fact__link" href={facetHref('cwe', c)}>
                          {c}
                        </a>
                      ) : (
                        c
                      )}
                    </>
                  ))}
                </dd>
              </div>
            )
          }
          {
            data.owasp.length > 0 && (
              <div class="fact">
                <dt>OWASP</dt>
                <dd class="ltr">{data.owasp.join(' · ')}</dd>
              </div>
            )
          }
          {
            data.toolsUsed.length > 0 && (
              <div class="fact">
                <dt>{t('writeup.tools')}</dt>
                <dd class="ltr">{data.toolsUsed.join(', ')}</dd>
              </div>
            )
          }
          {
            data.tags.length > 0 && (
              <div class="fact">
                <dt>{t('writeup.tags')}</dt>
                <dd class="ltr">{data.tags.join(', ')}</dd>
              </div>
            )
          }
        </dl>

        <div class="writeup__dates">
          <span class="ltr">{t('writeup.read').replace('{0}', String(minutes))}</span>
          <span class="ltr" aria-hidden="true">·</span>
          <span class="ltr">{publishedLabel}</span>
          {updatedLabel && <span class="ltr">· {updatedLabel}</span>}
        </div>
      </div>
    </header>

    {
      seriesMembers && seriesMembers.length > 0 && (
        <nav class="wrap writeup__series" aria-label={t('filter.series')}>
          <p class="writeup__series-name">
            <span class="u-label">{t('series.label')}</span>
            {seriesHref ? (
              <a class="writeup__series-link" href={seriesHref}>
                {data.series}
              </a>
            ) : (
              <span>{data.series}</span>
            )}
          </p>
          <ol class="writeup__series-list">
            {seriesMembers.map((m) =>
              slugOf(m) === slug ? (
                <li>
                  <span class="writeup__series-current" aria-current="true">
                    {m.data.title}
                  </span>
                </li>
              ) : (
                <li>
                  <a href={getRelativeLocaleUrl(lang, `/writeups/${slugOf(m)}`)}>{m.data.title}</a>
                </li>
              )
            )}
          </ol>
        </nav>
      )
    }

    <div class="wrap writeup__grid">
      {
        toc.length > 0 && (
          <aside class="writeup__toc" aria-label={t('writeup.toc')}>
            <p class="writeup__toc-label u-label ltr">{t('writeup.toc')}</p>
            <ol class="writeup__toc-list">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }

      <div class="writeup__content prose" data-pagefind-body={pagefindIgnore ? undefined : ''}>
        <Content components={mdxComponents} />
      </div>
    </div>

    {
      related.length > 0 && (
        <aside class="wrap writeup__related" aria-labelledby="related-title">
          <h2 id="related-title" class="u-label">
            {t('related.title')}
          </h2>
          <div class="writeup__related-grid">
            {related.map((e) => (
              <WriteupCard
                entry={e}
                caseNo={numbers.get(slugOf(e)) ?? 0}
                facets={facets}
                seriesPart={parts.get(slugOf(e))}
              />
            ))}
          </div>
        </aside>
      )
    }

    <footer class="wrap writeup__foot">
      {
        translation && (
          <a class="writeup__translate" href={getRelativeLocaleUrl(other, path)}>
            {lang === 'en' ? t('writeup.readInAr') : t('writeup.readInEn')}
          </a>
        )
      }
      <a class="writeup__back" href={getRelativeLocaleUrl(lang, '/writeups')}>
        {t('writeup.backToArchive')}
      </a>
    </footer>
  </article>
</Base>

<style>
  .writeup__head {
    padding-block-start: var(--space-7);
    border-block-end: var(--hairline) solid var(--line);
    padding-block-end: var(--space-6);
  }

  .writeup__eyebrow {
    font-family: var(--f-code);
    font-size: var(--text-xs);
    color: var(--blue-400);
    letter-spacing: var(--ls-meta);
    margin-block-end: var(--space-4);
  }

  .writeup__title {
    max-width: var(--measure-read);
  }

  .writeup__summary {
    margin-block-start: var(--space-5);
    max-width: var(--measure-lead);
    font-size: var(--step-1);
    color: var(--text-lo);
    line-height: var(--lh-lead);
  }

  .writeup__meta {
    margin-block-start: var(--space-6);
  }

  .writeup__stamps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .writeup__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-5);
    margin-block-start: var(--space-5);
    margin-block-end: 0;
  }

  @media (min-width: 640px) {
    .writeup__facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .fact {
    margin: 0;
  }

  .fact dt {
    font-family: var(--f-cond);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--blue-400);
  }

  .fact dd {
    margin: var(--space-1) 0 0;
    font-size: var(--step--1);
    color: var(--text);
  }

  /* Facet link inside a fact value — link only when the route exists. */
  .fact__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    color: var(--blue-400);
    text-decoration: none;
    border-block-end: var(--hairline) solid transparent;
  }

  .fact__link:hover {
    color: var(--sulfur-300);
    border-block-end-color: var(--sulfur-400);
  }

  /* Severity stamp wrapped in its facet link, kept at the touch-target floor. */
  .writeup__sevlink {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
  }

  /* ── Series strip (plan/04 F-02): compact, above the article body ── */
  .writeup__series {
    padding-block-start: var(--space-6);
  }

  .writeup__series-name {
    margin: 0 0 var(--space-3);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-family: var(--f-display);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: var(--ls-display);
    color: var(--text-hi);
  }

  html[lang='ar'] .writeup__series-name {
    font-family: var(--f-body-ar);
    letter-spacing: 0;
    line-height: var(--lh-ar);
  }

  .writeup__series-name .u-label {
    color: var(--text-dim);
  }

  .writeup__series-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    color: var(--text-hi);
    text-decoration: none;
    border-block-end: var(--hairline) solid transparent;
  }

  .writeup__series-link:hover {
    color: var(--sulfur-300);
    border-block-end-color: var(--sulfur-400);
  }

  .writeup__series-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .writeup__series-list a,
  .writeup__series-current {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    font-size: var(--step--1);
    line-height: var(--lh-body);
    color: var(--text-lo);
    text-decoration: none;
  }

  html[lang='ar'] .writeup__series-list a,
  html[lang='ar'] .writeup__series-current {
    line-height: var(--lh-ar);
  }

  .writeup__series-list a {
    border-block-end: var(--hairline) solid transparent;
  }

  .writeup__series-list a:hover {
    color: var(--sulfur-300);
    border-block-end-color: var(--sulfur-400);
  }

  .writeup__series-current {
    color: var(--sulfur-300);
  }

  /* ── Related case files (plan/04 F-02): matched by CWE, never padded ── */
  .writeup__related {
    padding-block: var(--space-6);
    border-block-start: var(--hairline) solid var(--line);
  }

  .writeup__related .u-label {
    display: block;
    margin-block-end: var(--space-4);
    color: var(--text-dim);
  }

  .writeup__related-grid {
    display: grid;
    gap: var(--hairline);
    background: var(--line);
    border: var(--hairline) solid var(--line);
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
  }

  .writeup__dates {
    margin-block-start: var(--space-5);
    font-family: var(--f-code);
    font-size: var(--text-xs);
    color: var(--text-dim);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* ── Grid: content + sticky TOC in the rail margin (plan/03 §3.3) ── */
  .writeup__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    padding-block-start: var(--space-7);
    padding-block-end: var(--space-8);
  }

  @media (min-width: 1080px) {
    .writeup__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 3fr);
      gap: var(--space-8);
    }

    .writeup__content {
      order: 1;
    }

    .writeup__toc {
      order: 2;
    }
  }

  .writeup__toc {
    position: sticky;
    top: calc(var(--space-5) + 56px);
    align-self: start;
    border-inline-start: var(--hairline) solid var(--line);
    padding-inline-start: var(--space-4);
  }

  .writeup__toc-label {
    margin-block-end: var(--space-3);
  }

  .writeup__toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .writeup__toc-list a {
    display: inline-block;
    min-height: var(--touch-min);
    line-height: var(--touch-min);
    font-size: var(--step--1);
    color: var(--text-lo);
    text-decoration: none;
    border-block-end: var(--hairline) solid transparent;
    transition:
      color var(--t-fast) ease,
      border-color var(--t-fast) ease;
  }

  .writeup__toc-list a:hover {
    color: var(--sulfur-300);
    border-block-end-color: var(--sulfur-400);
  }

  .writeup__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    padding-block: var(--space-6);
    border-block-start: var(--hairline) solid var(--line);
    font-family: var(--f-cond);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
  }

  .writeup__foot a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    color: var(--text-lo);
    text-decoration: none;
    border-block-end: var(--hairline) solid transparent;
  }

  .writeup__foot a:hover {
    color: var(--sulfur-300);
    border-block-end-color: var(--sulfur-400);
  }

  .writeup__back {
    margin-inline-start: auto;
  }
</style>
