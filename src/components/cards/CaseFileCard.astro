---
import { useTranslations } from '../../i18n/utils';
import type { Language } from '../../i18n/ui';
import type { FeaturedCase } from '../../data/featured-cases';

interface Props {
  lang: Language;
  data: FeaturedCase;
}

const { lang, data } = Astro.props;
const t = useTranslations(lang);

const statusKey = `status.${data.status}` as const;
const reading = t('case.min').replace('{0}', String(data.readingMinutes));
const caseId = `${t('case.id')} ${String(data.number).padStart(3, '0')} · ${data.category}`;
const Tag = data.href ? 'a' : 'article';
---

<Tag class:list={['case', data.href ? '' : 'case--static']} href={data.href || undefined}>
  <div class="case__top">
    <span class="case__id ltr">{caseId}</span>
    <span class:list={[`stamp stamp--${data.status}`, 'ltr']}>{t(statusKey)}</span>
  </div>
  <h3 class="case__title">{data.title[lang]}</h3>
  <div class="case__meta ltr">
    {
      data.cwe && (
        <span>
          <span class="k">CWE</span> {data.cwe}
        </span>
      )
    }
    {
      data.owasp && (
        <span>
          <span class="k">OWASP</span> {data.owasp}
        </span>
      )
    }
    <span>{data.targetType}</span>
    <span>{reading}</span>
    {data.hasFix && <span class="case__fix">{t('case.fix')}</span>}
  </div>
</Tag>

<style>
  .case {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--ink-900);
    text-decoration: none;
    transition: background var(--t-fast) ease;
  }

  .case:hover {
    background: var(--ink-800);
  }

  .case--static {
    cursor: default;
  }

  .case__top {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .case__id {
    font-family: var(--f-code);
    font-size: var(--text-xs);
    color: var(--blue-400);
    letter-spacing: var(--ls-meta);
  }

  .stamp {
    margin-inline-start: auto;
    font-family: var(--f-code);
    font-size: var(--text-2xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--ls-stamp);
    padding: var(--space-1) var(--space-2);
    border: var(--hairline) solid currentColor;
    border-radius: var(--radius);
    transform: rotate(-3deg);
    opacity: 0.9;
    white-space: nowrap;
  }

  .stamp--patched {
    color: var(--ok);
  }

  .stamp--lab-only {
    color: var(--blue-400);
  }

  .stamp--disclosed {
    color: var(--stamp-high);
  }

  .stamp--wip {
    color: var(--stamp-med);
  }

  .case__title {
    margin: 0;
    font-size: var(--step-0);
    font-weight: 600;
    font-family: var(--f-display);
    letter-spacing: var(--ls-display);
    color: var(--text-hi);
    line-height: var(--lh-body);
    transition: color var(--t-fast) ease;
  }

  .case:hover .case__title {
    color: var(--sulfur-300);
  }

  .case__meta {
    margin-block-start: auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    font-family: var(--f-code);
    font-size: var(--text-xs);
    color: var(--text-dim);
  }

  .case__meta .k {
    color: var(--blue-400);
  }

  .case__fix {
    color: var(--ok);
  }
</style>
