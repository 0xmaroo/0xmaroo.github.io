---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Stamp from '../writeup/Stamp.astro';
import { useTranslations } from '../../i18n/utils';
import { slugOf, type Writeup } from '../../lib/content';
import { readingTimeOf } from '../../lib/reading-time';
import type { UIKey } from '../../i18n/ui';

interface Props {
  entry: Writeup;
  /** Sequential case number from `caseNumbers()` in src/lib/content.ts. */
  caseNo: number;
}

const { entry, caseNo } = Astro.props;
const data = entry.data;
const lang = data.lang;
const t = useTranslations(lang);
const slug = slugOf(entry);
const statusVariant = {
  patched: 'ok',
  'lab-only': 'blue',
  disclosed: 'high',
  wip: 'med',
} as const;
const minutes = data.readingTime ?? readingTimeOf(entry.body ?? '', lang);
const caseId = `${t('case.id')} ${String(caseNo).padStart(3, '0')} · ${data.category.toUpperCase()}`;
const reading = t('case.min').replace('{0}', String(minutes));
const href = getRelativeLocaleUrl(lang, `/writeups/${slug}`);
---

<a class="case" href={href}>
  <div class="case__top">
    <span class="case__id ltr">{caseId}</span>
    <Stamp variant={statusVariant[data.status]} label={t(`status.${data.status}` as UIKey)} />
  </div>
  <h3 class="case__title">{data.title}</h3>
  <div class="case__meta ltr">
    {
      data.cwe.length > 0 && (
        <span>
          <span class="k">CWE</span> {data.cwe.join(', ')}
        </span>
      )
    }
    {
      data.owasp.length > 0 && (
        <span>
          <span class="k">OWASP</span> {data.owasp.join(' · ')}
        </span>
      )
    }
    <span>{data.targetType}</span>
    <span>{reading}</span>
    {data.hasFix && <span class="case__fix">{t('case.fix')}</span>}
  </div>
</a>

<style>
  .case {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--ink-900);
    text-decoration: none;
    transition: background var(--t-fast) ease;
  }

  .case:hover {
    background: var(--ink-800);
  }

  .case__top {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .case__id {
    font-family: var(--f-code);
    font-size: var(--text-xs);
    color: var(--blue-400);
    letter-spacing: var(--ls-meta);
  }

  .case__title {
    margin: 0;
    font-size: var(--step-0);
    font-weight: 600;
    font-family: var(--f-display);
    letter-spacing: var(--ls-display);
    color: var(--text-hi);
    line-height: var(--lh-body);
    transition: color var(--t-fast) ease;
  }

  .case:hover .case__title {
    color: var(--sulfur-300);
  }

  .case__meta {
    margin-block-start: auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    font-family: var(--f-code);
    font-size: var(--text-xs);
    color: var(--text-dim);
  }

  .case__meta .k {
    color: var(--blue-400);
  }

  .case__fix {
    color: var(--ok);
  }
</style>
