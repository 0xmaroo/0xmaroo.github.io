---
import { isTodo, journeyTimeline, type Journey } from '../../lib/proof';
import { useTranslations } from '../../i18n/utils';
import type { Language } from '../../i18n/ui';

/**
 * The journey timeline (plan/04 F-07), shared by /journey and the home page
 * §03. Stations come through `surfaceJourney()` — a claim without a real
 * proof URL, or a station still in TODO(copy), never renders.
 * `stations` lets a page that already surfaced the collection (to decide
 * whether to show the section at all) hand the list in instead of refetching.
 */
interface Props {
  lang: Language;
  /** h2 on /journey, h3 under the home page's section heading. */
  level?: 2 | 3;
  stations?: Journey[];
}

const { lang, level = 2, stations } = Astro.props;
const t = useTranslations(lang);
const timeline = stations ?? (await journeyTimeline());
const Heading = `h${level}` as const;

const dateFmt = new Intl.DateTimeFormat(lang === 'ar' ? 'ar' : 'en-US', {
  year: 'numeric',
  month: 'long',
  numberingSystem: 'latn', // Western digits in technical context (CLAUDE.md rule 5)
});
---

{
  timeline.length > 0 ? (
    <ol class="journey">
      {timeline.map((s) => (
        <li class="journey__stop">
          <div class="journey__mark" aria-hidden="true" />
          <div class="journey__body">
            {s.data.date && <p class="journey__date ltr">{dateFmt.format(s.data.date)}</p>}
            <Heading class="journey__event">{s.data.event[lang]}</Heading>
            {s.data.claim && (
              <a class="journey__claim ltr" href={s.data.proof} rel="nofollow noreferrer">
                {s.data.claim}
                <span class="journey__verify">{t('proof.verify')}</span>
              </a>
            )}
            {!isTodo(s.data.learned[lang]) && (
              <p class="journey__learned">
                <span class="journey__learned-k">{t('journey.learned')}</span>
                {s.data.learned[lang]}
              </p>
            )}
          </div>
        </li>
      ))}
    </ol>
  ) : (
    <p class="journey__empty">{t('journey.empty')}</p>
  )
}

<style>
  .journey {
    margin: var(--space-7) 0 0;
    padding: 0;
    list-style: none;
    border-inline-start: var(--hairline) solid var(--line);
  }

  .journey__empty {
    margin-block-start: var(--space-7);
    color: var(--text-lo);
    font-size: var(--step-1);
  }

  .journey__stop {
    position: relative;
    padding-inline-start: var(--space-6);
    padding-block-end: var(--space-7);
  }

  .journey__stop:last-child {
    padding-block-end: var(--space-4);
  }

  .journey__mark {
    position: absolute;
    inset-inline-start: 0;
    margin-inline-start: calc(-1 * var(--space-1));
    top: var(--space-2);
    width: var(--space-2);
    height: var(--space-2);
    border-radius: 50%;
    background: var(--ink-900);
    border: var(--hairline) solid var(--sulfur-400);
  }

  .journey__date {
    margin: 0 0 var(--space-2);
    font-family: var(--f-code);
    font-size: var(--text-xs);
    color: var(--blue-400);
  }

  .journey__event {
    margin: 0;
    font-size: var(--step-0);
    font-weight: 600;
    font-family: var(--f-display);
    letter-spacing: var(--ls-display);
    color: var(--text-hi);
    line-height: var(--lh-body);
  }

  html[lang='ar'] .journey__event {
    font-family: var(--f-body-ar);
    letter-spacing: 0;
  }

  .journey__claim {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-block-start: var(--space-3);
    font-family: var(--f-code);
    font-size: var(--step--1);
    color: var(--sulfur-300);
    text-decoration: none;
    border-block-end: var(--hairline) solid var(--sulfur-400);
  }

  .journey__claim:hover {
    color: var(--sulfur-400);
  }

  .journey__verify {
    font-size: var(--text-2xs);
    color: var(--blue-400);
  }

  .journey__learned {
    margin: var(--space-3) 0 0;
    max-width: var(--measure-lead);
    color: var(--text-lo);
    line-height: var(--lh-body);
    font-size: var(--step--1);
  }

  .journey__learned-k {
    display: block;
    font-family: var(--f-cond);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--blue-400);
    margin-block-end: var(--space-1);
  }

  html[lang='ar'] .journey__learned-k {
    font-family: var(--f-body-ar);
    text-transform: none;
    letter-spacing: 0;
  }
</style>
