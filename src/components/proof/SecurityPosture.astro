---
import { cspDirectives, referrerPolicy, unavailableHeaders } from '../../config/security';
import { site } from '../../config/site';
import { deployGates, pinnedActions, securityTxt, testCount } from '../../lib/posture';
import { useTranslations } from '../../i18n/utils';
import type { Language, UIKey } from '../../i18n/ui';

/**
 * /security (plan/09 F-13) — the site as its own case study. Every value is
 * derived at build time: the CSP from src/config/security.ts (the same
 * module Base.astro emits), the pins from .github/workflows, the gates from
 * package.json + deploy.yml, the expiry from security.txt. Each section links
 * the file it was read from.
 */
interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const source = (path: string) => `${site.repo}/blob/main/${path}`;

const actions = pinnedActions();
const pinned = actions.filter((a) => a.sha).length;
const gates = deployGates();
const tests = testCount();
const txt = securityTxt();
const dateFmt = new Intl.DateTimeFormat(lang === 'ar' ? 'ar' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  numberingSystem: 'latn',
});

const gateText = (key: string | null): string =>
  key ? t(`gate.${key}` as UIKey).replace('{0}', String(tests)) : '';
---

<section class="posture" aria-labelledby="posture-csp">
  <div class="posture__head">
    <h2 id="posture-csp" class="posture__title ltr">Content-Security-Policy</h2>
    <a class="posture__src ltr" href={source('src/config/security.ts')}>{t('security.source')}</a>
  </div>
  <p class="posture__note">{t('security.csp.note')}</p>
  <table class="posture__table">
    <thead>
      <tr>
        <th scope="col">{t('security.col.directive')}</th>
        <th scope="col">{t('security.col.value')}</th>
      </tr>
    </thead>
    <tbody>
      {
        cspDirectives.map(([name, value]) => (
          <tr>
            <th scope="row" class="ltr">
              {name}
            </th>
            <td class="ltr">{value || '✓'}</td>
          </tr>
        ))
      }
      <tr>
        <th scope="row" class="ltr">{t('security.referrer')}</th>
        <td class="ltr">{referrerPolicy}</td>
      </tr>
    </tbody>
  </table>
</section>

<section class="posture" aria-labelledby="posture-limits">
  <div class="posture__head">
    <h2 id="posture-limits" class="posture__title">{t('security.limits.title')}</h2>
  </div>
  <p class="posture__note">{t('security.limits.note')}</p>
  <ul class="posture__list ltr">
    {unavailableHeaders.map((h) => <li>{h}</li>)}
  </ul>
</section>

<section class="posture" aria-labelledby="posture-supply">
  <div class="posture__head">
    <h2 id="posture-supply" class="posture__title">{t('security.supply.title')}</h2>
    <a class="posture__src ltr" href={`${site.repo}/tree/main/.github/workflows`}>
      {t('security.source')}
    </a>
  </div>
  <p class="posture__note">
    {
      t('security.supply.note')
        .replace('{0}', String(pinned))
        .replace('{1}', String(actions.length))
    }
  </p>
  <!-- Scrolls sideways on narrow screens: focusable so a keyboard can too. -->
  <div class="posture__scroll" tabindex="0" role="region" aria-labelledby="posture-supply">
    <table class="posture__table posture__table--wide">
      <thead>
        <tr>
          <th scope="col">{t('security.col.action')}</th>
          <th scope="col">{t('security.col.version')}</th>
          <th scope="col">{t('security.col.commit')}</th>
          <th scope="col">{t('security.col.workflows')}</th>
        </tr>
      </thead>
      <tbody>
        {
          actions.map((a) => (
            <tr>
              <th scope="row" class="ltr">
                {a.action}
              </th>
              <td class="ltr">{a.version}</td>
              <td class="ltr">
                {a.sha ? (
                  <a class="posture__link" href={`https://github.com/${a.action}/commit/${a.sha}`}>
                    {a.sha.slice(0, 12)}
                  </a>
                ) : (
                  <span class="posture__bad">{t('security.unpinned')}</span>
                )}
              </td>
              <td class="ltr">{a.workflows.join(', ')}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<section class="posture" aria-labelledby="posture-gates">
  <div class="posture__head">
    <h2 id="posture-gates" class="posture__title">{t('security.gates.title')}</h2>
    <a class="posture__src ltr" href={source('package.json')}>{t('security.source')}</a>
  </div>
  <p class="posture__note">{t('security.gates.note')}</p>
  <ol class="posture__gates">
    {
      gates.map((g) => (
        <li class="gate">
          <code class="gate__cmd ltr">{g.command}</code>
          {g.key && <p class="gate__what">{gateText(g.key)}</p>}
          {g.source && (
            <a class="posture__link ltr" href={source(g.source)}>
              {g.source}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</section>

<section class="posture" aria-labelledby="posture-disclosure">
  <div class="posture__head">
    <h2 id="posture-disclosure" class="posture__title">{t('security.disclosure.title')}</h2>
    <a class="posture__src ltr" href="/.well-known/security.txt">security.txt</a>
  </div>
  <p class="posture__note">{t('security.disclosure.note')}</p>
  <dl class="posture__facts">
    <div>
      <dt class="ltr">Contact</dt>
      <dd class="ltr">{txt.contact}</dd>
    </div>
    {
      txt.expires && txt.daysLeft !== null && (
        <div>
          <dt>{t('security.expires')}</dt>
          <dd>
            <span class="ltr">{dateFmt.format(txt.expires)}</span> ·{' '}
            {t('security.daysLeft').replace('{0}', String(txt.daysLeft))}
          </dd>
        </div>
      )
    }
  </dl>
</section>

<style>
  .posture {
    margin-block-start: var(--space-7);
  }

  .posture__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-4);
  }

  .posture__title {
    margin: 0;
    font-size: var(--step-1);
  }

  .posture__src {
    margin-inline-start: auto;
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    font-family: var(--f-code);
    font-size: var(--text-xs);
    color: var(--blue-400);
    text-decoration: none;
  }

  .posture__src:hover {
    color: var(--sulfur-300);
  }

  .posture__note {
    margin-block: var(--space-2) var(--space-5);
    max-width: var(--measure-lead);
    color: var(--text-lo);
    font-size: var(--step--1);
  }

  .posture__scroll {
    overflow-x: auto;
  }

  .posture__table {
    width: 100%;
    border-collapse: collapse;
    border: var(--hairline) solid var(--line);
    font-size: var(--text-sm);
  }

  .posture__table th,
  .posture__table td {
    padding: var(--space-3) var(--space-4);
    border-block-end: var(--hairline) solid var(--line);
    text-align: start;
    vertical-align: middle;
    overflow-wrap: anywhere;
  }

  /* SHAs and versions must never break mid-token (v7 / .0 / .1 at 360px):
     the table keeps its width and its own box scrolls, not the page. */
  .posture__table--wide th,
  .posture__table--wide td {
    white-space: nowrap;
    overflow-wrap: normal;
  }

  .posture__table thead th {
    font-family: var(--f-cond);
    font-size: var(--text-xs);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--blue-400);
    background: var(--ink-800);
  }

  html[lang='ar'] .posture__table thead th {
    font-family: var(--f-body-ar);
    text-transform: none;
    letter-spacing: 0;
  }

  .posture__table tbody th {
    font-family: var(--f-code);
    font-weight: 600;
    color: var(--text-hi);
  }

  .posture__table td {
    font-family: var(--f-code);
    color: var(--text);
  }

  /* Blue: these are metadata links. Sulfur stays the one thing to notice. */
  .posture__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    font-family: var(--f-code);
    font-size: var(--text-sm);
    color: var(--blue-400);
    text-decoration: none;
    border-block-end: var(--hairline) solid transparent;
  }

  .posture__link:hover {
    color: var(--sulfur-300);
    border-block-end-color: var(--sulfur-400);
  }

  .posture__bad {
    color: var(--stamp-crit);
  }

  .posture__list {
    margin: 0;
    padding-inline-start: var(--space-5);
    font-family: var(--f-code);
    font-size: var(--text-sm);
    color: var(--text);
  }

  .posture__gates {
    margin: 0;
    padding: 0;
    list-style: none;
    border: var(--hairline) solid var(--line);
  }

  .gate {
    padding: var(--space-4);
    border-block-end: var(--hairline) solid var(--line);
  }

  .gate:last-child {
    border-block-end: none;
  }

  .gate__cmd {
    font-family: var(--f-code);
    font-size: var(--text-sm);
    color: var(--text-hi);
    overflow-wrap: anywhere;
  }

  .gate__what {
    margin: var(--space-2) 0 0;
    color: var(--text-lo);
    font-size: var(--step--1);
  }

  .posture__facts {
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }

  .posture__facts dt {
    font-family: var(--f-cond);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--blue-400);
  }

  html[lang='ar'] .posture__facts dt:not(.ltr) {
    font-family: var(--f-body-ar);
    text-transform: none;
    letter-spacing: 0;
  }

  .posture__facts dd {
    margin: var(--space-1) 0 0;
    font-family: var(--f-code);
    font-size: var(--text-sm);
    color: var(--text);
    overflow-wrap: anywhere;
  }
</style>
