---
/**
 * Serialise one JSON-LD node into a <script type="application/ld+json"> data
 * block (plan/05 Phase 5). A data block is not an executed script, so it stays
 * inline and is NOT subject to the CSP `script-src 'self'` — never externalise
 * it. Builders live in src/lib/schema.ts; pages never hand-build a node.
 */
interface Props {
  data: Record<string, unknown>;
}

const { data } = Astro.props;
---

<script type="application/ld+json" set:html={JSON.stringify(data)} is:inline />
