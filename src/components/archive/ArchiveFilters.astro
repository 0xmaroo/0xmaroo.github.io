---
import { getRelativeLocaleUrl } from 'astro:i18n';
import {
  FACET_KINDS,
  facetGroups,
  facetLabelKey,
  facetPath,
  type FacetKind,
  type Writeup,
} from '../../lib/content';
import { useTranslations } from '../../i18n/utils';
import type { Language, UIKey } from '../../i18n/ui';

interface Props {
  lang: Language;
  /** Archive-surfaced entries for `lang` — grouping happens in `facetGroups()`. */
  entries: Writeup[];
  /** Kind + slug of the facet page currently rendered, to mark the active chip. */
  active?: { kind: FacetKind; slug: string };
}

const { lang, entries, active } = Astro.props;
const t = useTranslations(lang);

// Severity labels are localized; every other facet value is a technical
// identifier that stays Latin and LTR even inside Arabic pages.
const isTechnical = (kind: FacetKind): boolean => kind !== 'severity' && kind !== 'series';
const valueLabel = (kind: FacetKind, value: string): string =>
  kind === 'severity' ? t(`severity.${value}` as UIKey) : value;
---

<nav class="fbar" aria-label={t('filter.label')}>
  {
    FACET_KINDS.map((kind) => {
      const groups = facetGroups(entries, kind);
      return (
        groups.length > 0 && (
          <div class="fbar__group">
            <p class="fbar__name u-label">{t(facetLabelKey[kind])}</p>
            <ul class="fbar__values">
              {groups.map((g) => {
                const on = active?.kind === kind && active.slug === g.slug;
                return (
                  <li>
                    {g.linkable ? (
                      <a
                        class:list={['fbar__chip', isTechnical(kind) && 'ltr', on && 'is-on']}
                        href={getRelativeLocaleUrl(lang, facetPath(kind, g.slug))}
                        aria-current={on ? 'true' : undefined}
                      >
                        {valueLabel(kind, g.value)}
                      </a>
                    ) : (
                      // Below FACET_MIN_ENTRIES: plain text, never a link and
                      // never a dead href (plan/04 F-03).
                      <span
                        class:list={['fbar__chip fbar__chip--text', isTechnical(kind) && 'ltr']}
                      >
                        {valueLabel(kind, g.value)}
                      </span>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        )
      );
    })
  }
</nav>

<style>
  .fbar {
    margin-block-start: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .fbar__group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }

  .fbar__name {
    margin: 0;
    color: var(--text-dim);
    min-width: var(--touch-min);
  }

  .fbar__values {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .fbar__chip {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    padding-inline: var(--space-3);
    font-family: var(--f-cond);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--text-lo);
    text-decoration: none;
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
  }

  @media (prefers-reduced-motion: no-preference) {
    .fbar__chip {
      transition:
        color var(--t-fast) ease,
        border-color var(--t-fast) ease;
    }
  }

  .fbar__chip:hover {
    color: var(--text-hi);
    border-color: var(--sulfur-400);
  }

  .fbar__chip.is-on {
    color: var(--ink-900);
    background: var(--sulfur-400);
    border-color: var(--sulfur-400);
  }

  /* Below-threshold value: text, not a control — no border, no hover. */
  .fbar__chip--text {
    color: var(--text-dim);
    border-color: transparent;
  }

  .fbar__chip--text:hover {
    color: var(--text-dim);
    border-color: transparent;
  }

  html[lang='ar'] .fbar__chip {
    font-family: var(--f-body-ar);
    text-transform: none;
    letter-spacing: 0;
  }
</style>
