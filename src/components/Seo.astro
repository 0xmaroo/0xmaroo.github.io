---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Language } from '../i18n/ui';

interface Props {
  lang: Language;
  /** Locale-independent path (plan/02 §2.2) — the same slug in both languages. */
  path: string;
  /**
   * Override the alternate set. Omit for pages that exist in both locales.
   * Pass an explicit map (possibly empty) for writeups without a translation,
   * so hreflang never points at a page that does not exist.
   */
  alternates?: Partial<Record<Language, string>>;
  robots?: 'index' | 'noindex';
  /** Page title for the document and og:title. */
  title?: string;
  /** Page description for og:description. */
  description?: string;
}

const { lang, path } = Astro.props;
const alternates = Astro.props.alternates;
const robots = Astro.props.robots ?? 'index';
const title = Astro.props.title ?? '0xMARO — Blueprint & Breach';
const description = Astro.props.description;
const site = Astro.site!;

const canonical = new URL(getRelativeLocaleUrl(lang, path), site);
const otherLangs = alternates
  ? (Object.keys(alternates) as Language[])
  : (['en', 'ar'] as Language[]);
const defaultHref = new URL(getRelativeLocaleUrl('en', alternates?.en ?? path), site);

const urlFor = (l: Language): string =>
  new URL(getRelativeLocaleUrl(l, alternates?.[l] ?? path), site).href;

// Phase 3: default per-locale OG images generated at build time (src/lib/og.ts).
const ogImage = new URL(`/og/og-default-${lang}.png`, site);
const ogLocale = lang === 'ar' ? 'ar_AR' : 'en_US';
---

<link rel="canonical" href={canonical.href} />
{otherLangs.map((l) => <link rel="alternate" hreflang={l} href={urlFor(l)} />)}
<link rel="alternate" hreflang="x-default" href={defaultHref.href} />
{robots === 'noindex' && <meta name="robots" content="noindex,follow" />}

<meta property="og:type" content="website" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:site_name" content="0xMARO" />
<meta property="og:url" content={canonical.href} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:image" content={ogImage.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
