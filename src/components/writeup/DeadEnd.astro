---
import { useTranslations } from '../../i18n/utils';
import type { Language } from '../../i18n/ui';

const lang = (Astro.currentLocale ?? 'en') as Language;
const t = useTranslations(lang);
---

<aside class="deadend" role="note">
  <p class="deadend__label u-label ltr">{t('writeup.deadEnd')}</p>
  <div class="deadend__body prose">
    <slot />
  </div>
</aside>

<style>
  .deadend {
    margin-block: var(--space-6);
    padding: var(--space-4) var(--space-5);
    background: var(--ink-800);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
    border-inline-start: var(--rule-thickness) solid var(--text-dim);
    opacity: 0.85;
  }

  .deadend__label {
    margin-block-end: var(--space-2);
    color: var(--text-dim);
  }

  .deadend__body {
    color: var(--text-lo);
    font-size: var(--step--1);
  }

  .deadend__body > :first-child {
    margin-block-start: 0;
  }

  .deadend__body > :last-child {
    margin-block-end: 0;
  }
</style>
